#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
#
# tposd-key -- the ThinkPad mic-mute key; run as root by devd(8), see
# @PREFIX@/etc/devd/tposd.conf
#
#   tposd-key micmute   mic-mute key (ACPI IBM notify 0x1b): toggle the
#                       microphone mute ("tposd micmute", the recording
#                       level of every mixer) and set its LED
#
# tposd(1) shows the notification.  The speaker mute key sends no event: the
# embedded controller handles it, and tposd sets its LED.

if [ "$1" != micmute ]; then
	echo "usage: tposd-key micmute" >&2
	exit 2
fi

case $(@BINDIR@/tposd micmute toggle) in
on)	exec @LIBEXECDIR@/tposd-mute-led mic 1 ;;
off)	exec @LIBEXECDIR@/tposd-mute-led mic 0 ;;
*)	exit 1 ;;
esac
