[
{ type: install
  message: <<EOM
tposd needs some system configuration, which installing does not change.
Run once, as root:

    tposd-setup        # or "tposd-setup -n" to see the steps first

It loads acpi_ibm and acpi_call (now and in /boot/loader.conf), gives
pkexec's PAM service a session stack without pam_lastlog (whose "Last
login" message makes pkexec abort; the original is kept as
%%PREFIX%%/etc/pam.d/polkit-1.orig), restarts devd for the mic-mute rule
and sets the OSS pcm level to 1.00.

Then log out and in again (tposd starts with the session) and add the
panel item "ThinkPad Controls".  Bind the brightness keys to
"tposd brightness +10" / "tposd brightness -10" in Settings -> Keyboard ->
Application Shortcuts; leave the volume keys to the PulseAudio plugin.
EOM
}
{ type: upgrade
  maximum_version: "0.1.0"
  message: <<EOM
The devd rule for the mic-mute key is now %%PREFIX%%/etc/devd/tposd.conf.
Restart devd to read it, as root:

    service devd restart

then log out and in again: PulseAudio's module-devd-detect makes pulseaudio
exit when devd restarts, and programs playing sound lose it.
EOM
}
{ type: remove
  message: <<EOM
tposd-setup's changes stay: acpi_ibm_load/acpi_call_load in
/boot/loader.conf and %%PREFIX%%/etc/pam.d/polkit-1 (original in
polkit-1.orig).
EOM
}
]
